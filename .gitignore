# Default-deny: only reviewed source and documentation are publishable.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/NOTICE.md
!/LICENSE
!/pyproject.toml
!/environment.yml
!/src/
!/tests/
!/configs/
!/scripts/
!/licenses/
# Deny nested artifacts even inside an allowed source directory.
**/__pycache__/
**/.pytest_cache/
**/*.py[cod]
**/*.egg-info/
**/.env*
**/*credential*
**/*secret*
**/*.pem
**/*.key
**/*.pt
**/*.pth
**/*.ckpt
**/*.safetensors
**/*.onnx
**/*.npz
**/*.npy
**/*.wad
**/*.pk3
**/*.zip
**/*.exe
**/*.dll
**/*.pdf
**/*.docx
**/*.log
**/*.jsonl
**/*.png
**/*.jpg
**/*.csv
**/runs/
**/results/
**/reports/
**/data/
**/checkpoints/
